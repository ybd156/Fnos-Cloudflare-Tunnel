#!/bin/bash
# Cloudflare Tunnel for fnOS - applies the settings collected by wizard/config.
#
# The wizard answers arrive as environment variables (wizard_*). They are merged
# into $PKGVAR/config.json with a read-modify-write so that tunnel definitions
# and tokens are never clobbered.
set -u

. "$(dirname "$0")/_lib"

CONFIG_FILE="${PKGVAR}/config.json"
SERVER_BIN="${APPDEST}/bin/fncfd"

[ -x "${SERVER_BIN}" ] || fail "应用文件缺失或不可执行：${SERVER_BIN}，请尝试重新安装应用。"
mkdir -p "${PKGVAR}" || fail "无法创建数据目录 ${PKGVAR}。"

# The merge is performed by the service binary itself. It owns the config
# format, and this script used to need a Node runtime purely to edit JSON --
# which is exactly the dependency the package no longer has. `config-set` reads
# the same wizard_* variables from the environment and rewrites only the
# settings half of the file.
"${SERVER_BIN}" config-set || fail "写入配置文件 ${CONFIG_FILE} 失败。"

log_info "Settings saved to ${CONFIG_FILE}."
exit 0

#!/bin/bash
# Shared helpers for the fnOS lifecycle scripts.
#
# This file is sourced, never executed directly:
#
#     . "$(dirname "$0")/_lib"
#
# It provides the TRIM_*-derived locations, the logging helpers every script
# needs, and the `fail` that surfaces a message through the App Center.
# Everything here must stay safe under `set -u`.
#
# There is deliberately no runtime probe here any more: the service is a single
# static binary shipped in the payload (app/bin/fncfd), so the app declares no
# dependency apps and nothing has to be located in PATH.

APPNAME="${TRIM_APPNAME:-cloudflared}"
APPDEST="${TRIM_APPDEST:-/var/apps/${APPNAME}/target}"
PKGVAR="${TRIM_PKGVAR:-/var/apps/${APPNAME}/var}"
PKGTMP="${TRIM_PKGTMP:-/var/apps/${APPNAME}/tmp}"
PKGETC="${TRIM_PKGETC:-/var/apps/${APPNAME}/etc}"
CMD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd || true)"
[ -n "${CMD_DIR}" ] || CMD_DIR="/var/apps/${APPNAME}/cmd"

# Log lines carry the script name so one app-centre log shows which step spoke.
CF_SCRIPT="${CF_SCRIPT:-${0##*/}}"

cf_log() {
    local level="$1"
    shift
    printf '[%s] [%s] [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "${CF_SCRIPT}" "${level}" "$*"
}

log_info() { cf_log INFO "$@"; }
log_error() { cf_log ERROR "$@" >&2; }

# Surface a user-visible message through the App Center, then fail.
fail() {
    local message="$1"
    log_error "${message}"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "${message}" >"${TRIM_TEMP_LOGFILE}" 2>/dev/null || true
    fi
    exit 1
}
